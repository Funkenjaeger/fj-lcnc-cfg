o<measure> sub
 #<coord_system_was>=#<_coord_system>  (Save current coordinate system.)
 G30.1 (latch current absolute position)
 #<x0_abs> = #5181
 #<y0_abs> = #5182

 M70                                                                (Save modal state)
 M5                                                                 (Turn spindle off)
 M9                                                                 (Turn coolant off)
 G17 G20 G40 G64 P0.001 G80 G94 G97 G98                             (Baseline modal state)
 
 M210 P1 (retract dust shoe temporarily)

 o217 if [#<coord_system_was> EQ 593]
  (msg,Note: G59.3 coordinate system is active, be sure that's what you intended!)
 o217 endif
 
 G59.3																		(Switch temporarily to G59.3 WCS for probing)
 G10 L2 P9 X0 Y0 Z0															(Zero out work coordinate offsets in G59.3)

 G43																		(Enable tool length compensation)

 G28.1																		(Read current absolute position in machine coordinates into #5161-5166)
 o300 if [ [ ABS[#5161 - #<_ini[TOOLSENSOR]X_LOC>] LT 0.01 ] AND [ ABS[#5162 - #<_ini[TOOLSENSOR]Y_LOC>] LT 0.01 ] ]
	G53 G0 X#<_ini[TOOLSENSOR]X_LOC> Y#<_ini[TOOLSENSOR]Y_LOC>					(Move to tool setter postion)
 o300 else
	G53 G90 G0 Z0																(Z up)
	G53 G0 X#<_ini[TOOLSENSOR]X_LOC> Y#<_ini[TOOLSENSOR]Y_LOC>					(Move to tool setter postion)
	G53 G0 Z#<_ini[TOOLSENSOR]Z_PROBE_START>									(Move Z  to safe height above tool setter to start probe)
 o300 endif
 
 (Measure tool to get offset)
 ; M64 is an IMMEDIATE output - it executes at interpreter read-ahead time, not
 ; synchronized with motion. With an empty motion queue (e.g. the startup
 ; remeasure) the interpreter reads far ahead and enables the optical sensor
 ; while the approach moves are still running, so a long tool sweeping into the
 ; beam during a non-probe move trips "probe tripped during non-probe move".
 ; M66 ... L0 reads an input immediately, which busts the read-ahead queue and
 ; forces the approach motion to finish before the optical sensor is enabled.
 M66 P6 L0																	(Queue buster: finish approach before enabling optical)
 M64 P2																		(Turn on optical sensor)
 ; --- No-tool detection ---
 ; Probe down only as far as the go/no-go threshold, using G38.3 so a no-trip is
 ; NOT an error. A properly-loaded tool breaks the optical beam ABOVE this Z; if
 ; we reach the threshold without a trip (#5070 == 0) there is no valid tool in
 ; the spindle, so retract and abort rather than continue plunging at the setter.
 G38.3 G90 Z#<_ini[TOOLSENSOR]Z_NO_TOOL> F#<_ini[TOOLSENSOR]SEARCH_VEL>		(Approach to no-tool threshold)
 o400 if [#5070 EQ 0]
  M65 P2																	(Turn off optical sensor)
  G53 G90 G0 Z#<_ini[TOOLSENSOR]Z_SAFE>										(Retract to safe Z before aborting)
  (abort,No tool detected at tool setter - confirm a tool is actually loaded)
 o400 endif
 ; --- Tool detected above threshold, proceed with normal measurement ---
 M65 P2																		(Turn off optical sensor)
 M66 P6 L4 Q1																(Wait for optical-in to deactivate)
 G38.2 G90 Z#<_ini[TOOLSENSOR]Z_PROBE_END> F#<_ini[TOOLSENSOR]COARSE_VEL>	(Measure Gross)
 G38.5 G91 Z#<_ini[TOOLSENSOR]Z_BACKOFF> F#<_ini[TOOLSENSOR]FINE_VEL>		(Back off until probe breaks contact)
 ;G0 G91 Z#<_ini[TOOLSENSOR]Z_BACKOFF>										(Back off safe distance)
 ;G38.2 G90 Z#<_ini[TOOLSENSOR]Z_PROBE_END> F#<_ini[TOOLSENSOR]FINE_VEL>		(Measure fine)
 #<_new_tlo> = #5063
 ;G38.5 G91 Z#<_ini[TOOLSENSOR]Z_BACKOFF> F#<_ini[TOOLSENSOR]COARSE_VEL>		(Back off until probe breaks contact)
 ;G0 G91 Z#<_ini[TOOLSENSOR]Z_BACKOFF>										(Back off safe distance)		
 G53 G90 G0 Z#<_ini[TOOLSENSOR]Z_SAFE>										(Z up to safe position)

 (Restore original coordinate system. G54 to G59.2 only)
 o100 if[#<coord_system_was> EQ 540]
   G54
 o100 endif
 o101 if[#<coord_system_was> EQ 550]
   G55
 o101 endif
 o102 if[#<coord_system_was> EQ 560]
   G56
 o102 endif
 o103 if[#<coord_system_was> EQ 570]
   G57
 o103 endif
 o104 if[#<coord_system_was> EQ 580]
   G58
 o104 endif
 o105 if[#<coord_system_was> EQ 590]
   G59
 o105 endif
 o106 if[#<coord_system_was> EQ 591]
   G59.1
 o106 endif
 o107 if[#<coord_system_was> EQ 592]
   G59.2
 o107 endif

 (return to initial XY position and end temporary dust shoe retract *unless* P1 argument was passed)
 #<reengage> = 1
 o900 if [EXISTS[#<p>]]
  o901 if [#<p> EQ 1] 
   #<reengage> = 0
  o901 endif
 o900 endif
 
 o902 if [#<reengage> EQ 1]
  G53 G90 G0 X#<x0_abs> Y#<y0_abs> (return to initial XY position)
  M211 P1 (re-engage dust shoe conditionally - only if it was previously engaged)
 o902 endif

M72                                                                			(Restore saved modal state)
G43.1 Z#<_new_tlo>															(Set Dynamic TLO)

o<measure> endsub
M2
